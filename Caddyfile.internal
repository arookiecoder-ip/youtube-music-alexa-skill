# Trust visitor-IP headers only when the TCP peer is a published Cloudflare edge.
# Range snapshot: https://api.cloudflare.com/client/v4/ips (2026-11-13).
{
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP
    }
}

# Fallback Caddyfile for an origin behind Cloudflare in Full (non-strict)
# mode, used only when public ACME issuance cannot complete. Cloudflare still
# presents a publicly trusted edge certificate to browsers; this only protects
# the Cloudflare-to-origin hop.
#
# Enable with:
#   CADDYFILE=Caddyfile.internal
# in the deployment env file, then recreate the caddy service.
{$SITE_ADDRESS:localhost} {
    # Canonicalize before forward_auth and every reverse_proxy. For a direct
    # connection, {client_ip} is the TCP peer, never a client-supplied header.
    request_header CF-Connecting-IP {client_ip}

    tls internal

    handle_path /youtube-login/* {
        forward_auth ytmusic:5000 {
            uri /api/youtube/browser-session/authorize
            header_up -Connection
            header_up -Upgrade
        }
        header Cache-Control "no-store"
        reverse_proxy youtube-browser:6080
    }

    handle /alexa/proxy/* {
        forward_auth ytmusic:5000 {
            uri /alexa/proxy_authorize/
            header_up -Connection
            header_up -Upgrade
            copy_headers X-MusicBox-Proxy-Authorization
        }
        header Cache-Control "no-store"
        reverse_proxy ytmusic:5001
    }

    handle {
        reverse_proxy ytmusic:5000
    }
}
