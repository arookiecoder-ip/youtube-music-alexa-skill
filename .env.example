YTDLP_COOKIES=/app/cookies.txt
# Optional yt-dlp player-client order trial (comma-separated). Default when unset:
# default,android_vr,web,tv. Example once the bgutil provider is verified:
# YTDLP_CLIENT_ORDER=tv_simply,web_embedded,default,android_vr,web,tv
# Unknown names are dropped; a fully-invalid value falls back to the default.
# Audio cache maintenance runs inside the ytmusic service; no host cron needed.
AUDIO_PARTIAL_TTL=7200
AUDIO_CACHE_SWEEP_INTERVAL=1800
# Completed songs have no idle expiry. Shared LRU limits (MiB, 0 = off):
# least recently used unprotected files go first when space is needed.
# 5 GB total is ~1500 tracks at ~3 MB each; safe on a 100 GB host.
AUDIO_CACHE_MAX_MB=5120
AUDIO_CACHE_MIN_FREE_MB=512
# Prefetched audio shares the same budget and LRU order as played audio.
# Legacy WARMUP_TTL/WARMUP_MAX_MB are ignored. AUDIO_CACHE_TTL, if still set,
# is only a fallback timeout for abandoned .part files, never completed songs.
# Bounded server wait (seconds) for a cold /audio/ miss on the wait/Range/HEAD
# path. Fits inside the app's 60 s socket timeout; the download keeps running
# after a 503 so a retry lands warm. Plain misses keep live-streaming.
AUDIO_WAIT_SECONDS=25
# Address served by Caddy. Use a hostname in production for automatic HTTPS,
# or http://localhost for local HTTP testing.
SITE_ADDRESS=http://localhost
# Shared secret used only for Flask-to-Chromium-sidecar control requests.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
YT_BROWSER_CONTROL_TOKEN=<generate-a-random-64-character-hex-token>
# Optional: maximum time allowed to complete interactive Google sign-in.
YT_BROWSER_LOGIN_TIMEOUT=240
# Seconds to display connection success before the secure browser exits.
YT_BROWSER_SUCCESS_DISPLAY=12
# Must be the actual public hostname the Echo/Alexa Lambda will reach this
# server at (a sslip.io hostname, or your own domain). If you migrate to a
# custom domain later, update this AND DEFAULT_API_URL in lambda/api_key.py —
# a stale value here is a common cause of "search works, no audio plays".
PUBLIC_BASE_URL=https://<your-ip-with-dashes>.sslip.io
API_KEY=<same value as lambda/api_key.py>
AMAZON_DOMAIN=amazon.in
SECRET_KEY=<openssl rand -hex 32>
REMOTE_USER=<pick a username>
REMOTE_PASSWORD=<pick a strong password>
REMOTE_TOTP_SECRET=<base32 secret, optional 2FA>
# Optional: only needed if the Amazon login proxy is served from a separate
# hostname/Caddy site block. Defaults to PUBLIC_BASE_URL if unset.
ALEXA_PROXY_BASE_URL=<https://your-proxy-hostname>

# Optional: YT Music browser auth file path for personalized recommendations.
# See: web remote → profile menu → "Fix personalized YouTube data"
# YTMUSIC_AUTH_FILE=/app/ytmusic_auth.json

# Optional bounded, sanitized 24-hour operational journal (default beside DB_FILE).
# STATUS_LOG_DB=/app/data/status_logs.sqlite3
# Docker defaults to persistent YouTube streaming for Echo and web/phone.
# Set 0 to restore the legacy yt-dlp/cache playback path.
# YOUTUBE_STREAMING=1
