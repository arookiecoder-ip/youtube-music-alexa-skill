YTDLP_COOKIES=/app/cookies.txt
# Optional yt-dlp player-client order trial (comma-separated). Default when unset:
# default,android_vr,web,tv. Example once the bgutil provider is verified:
# YTDLP_CLIENT_ORDER=tv_simply,web_embedded,default,android_vr,web,tv
# Unknown names are dropped; a fully-invalid value falls back to the default.
# Address served by Caddy. Use a hostname in production for automatic HTTPS,
# or http://localhost for local HTTP testing.
SITE_ADDRESS=http://localhost
# Shared secret used only for Flask-to-Chromium-sidecar control requests.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
YT_BROWSER_CONTROL_TOKEN=<generate-a-random-64-character-hex-token>
# Optional: maximum time allowed to complete interactive Google sign-in.
YT_BROWSER_LOGIN_TIMEOUT=240
# Seconds to display connection success before the secure browser exits.
YT_BROWSER_SUCCESS_DISPLAY=12
# Must be the actual public hostname the Echo/Alexa Lambda will reach this
# server at (a sslip.io hostname, or your own domain). If you migrate to a
# custom domain later, update this AND DEFAULT_API_URL in lambda/api_key.py —
# a stale value here is a common cause of "search works, no audio plays".
PUBLIC_BASE_URL=https://<your-ip-with-dashes>.sslip.io
API_KEY=<same value as lambda/api_key.py>
AMAZON_DOMAIN=amazon.in
SECRET_KEY=<openssl rand -hex 32>
REMOTE_USER=<pick a username>
REMOTE_PASSWORD=<pick a strong password>
REMOTE_TOTP_SECRET=<base32 secret, optional 2FA>
# Optional: only needed if the Amazon login proxy is served from a separate
# hostname/Caddy site block. Defaults to PUBLIC_BASE_URL if unset.
ALEXA_PROXY_BASE_URL=<https://your-proxy-hostname>

# Optional: YT Music browser auth file path for personalized recommendations.
# See: web remote → profile menu → "Fix personalized YouTube data"
# YTMUSIC_AUTH_FILE=/app/ytmusic_auth.json

# Optional bounded, sanitized 24-hour operational journal (default beside DB_FILE).
# STATUS_LOG_DB=/app/data/status_logs.sqlite3
# Docker initializes the persistent YouTube streaming client at startup.
# YOUTUBE_STREAMING=1

# Private token between the direct-network gateway and optional VPN endpoint.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MUSICBOX_EGRESS_TOKEN=

# ---------------------------------------------------------------------------
# Optional multi-user layer (disabled unless MULTI_USER_ENABLED=1)
# ---------------------------------------------------------------------------
# The admin panel is mounted at /admin. With the flag off, no routes or tables
# are created and the existing single-owner app is unchanged.
MULTI_USER_ENABLED=0
MULTIUSER_APP_NAME=Music Box
MULTIUSER_ADMIN_USER=admin
# Bootstrap only: used once, when the users table is empty. Leave blank to
# generate a password and write it to multiuser_admin_password.txt beside DB_FILE.
MULTIUSER_ADMIN_PASSWORD=
# Optional. If set, the bootstrap owner starts with a verified email address.
MULTIUSER_ADMIN_EMAIL=
# Public origin used in email links. Must be the real https:// origin.
MULTIUSER_PUBLIC_BASE_URL=https://testalexa.synthora.in
MULTIUSER_TEST_ENVIRONMENT=1
MULTIUSER_SESSION_HOURS=12
MULTIUSER_SESSION_ABSOLUTE_DAYS=7
MULTIUSER_LOGIN_MAX_ATTEMPTS=5
MULTIUSER_LOGIN_WINDOW_SECONDS=900
MULTIUSER_REQUEST_MAX_PER_MINUTE=180
MULTIUSER_BACKUP_DIR=/data/backups
# Generate once: python3 scripts/generate-multiuser-key.py
# Losing this key makes stored provider credentials unrecoverable.
MULTIUSER_ENCRYPTION_KEY=

# Self-service accounts: /signup, /forgot-password, /account and self-delete are
# mounted with the layer, so these are the only switches the public door has.
# Self-signup still requires a verified email address before the account can sign
# in (MULTIUSER_REQUIRE_EMAIL_VERIFICATION), and the daily cap is counted in the
# database, so it survives a restart -- unlike every in-process limit.
MULTIUSER_SELF_SIGNUP_ENABLED=1
MULTIUSER_MAX_SELF_SIGNUPS_PER_DAY=25
# A form filled faster than this is a bot: the sign-up page issues a nonce and
# measures how long it has been held. Too low blocks people on a phone.
MULTIUSER_SIGNUP_MIN_SECONDS=3

# Which address a visitor's limits key on. Behind a reverse proxy the peer address
# is the proxy, so the forwarded chain is used -- but only when the immediate peer
# is actually a proxy: either a private/loopback address (docker, same host) or one
# inside these CIDRs. Add Caddy's network here when it runs somewhere else.
# List, not one: MULTIUSER_TRUSTED_PROXY_CIDRS=172.18.0.0/16,127.0.0.1/32
MULTIUSER_TRUSTED_PROXY_CIDRS=
# Believe CF-Connecting-IP as well as X-Forwarded-For. Only correct while the public
# origin really is proxied by Cloudflare: with this set and the origin reachable
# directly, a visitor could choose the address their own limits key on. The proxy-
# peer rule above still applies, so this cannot bypass it.
MULTIUSER_TRUST_CLOUDFLARE=0

# Seconds between passes of the queue of account deletions whose files could not
# be removed the first time (minimum 15). A purge left unfinished is retried with
# backoff for 24 hours and then logged as an operator problem.
ACCOUNT_PURGE_SWEEP_SECONDS=60

# Email authentication. Without SMTP, one-time links are written as .eml files
# to MULTIUSER_MAIL_OUTBOX (never logged) and must be retrieved from the server.
MULTIUSER_REQUIRE_EMAIL_VERIFICATION=1
MULTIUSER_MAGIC_LINK_ENABLED=1
MULTIUSER_VERIFY_TOKEN_HOURS=24
MULTIUSER_RESET_TOKEN_MINUTES=60
MULTIUSER_MAGIC_TOKEN_MINUTES=15
MULTIUSER_INVITE_TOKEN_HOURS=72
MULTIUSER_SMTP_HOST=
MULTIUSER_SMTP_PORT=587
# starttls | ssl | none
MULTIUSER_SMTP_SECURITY=starttls
MULTIUSER_SMTP_USERNAME=
MULTIUSER_SMTP_PASSWORD=
MULTIUSER_SMTP_TIMEOUT=12
MULTIUSER_MAIL_FROM=no-reply@synthora.in
MULTIUSER_MAIL_FROM_NAME=Music Box
MULTIUSER_MAIL_REPLY_TO=
MULTIUSER_MAIL_OUTBOX=/data/mail-outbox
# Test-only: redirect every email to one inbox. Leave blank in production.
MULTIUSER_MAIL_REDIRECT_TO=
# Test-only: do not contact the SMTP server at all.
MULTIUSER_MAIL_SUPPRESS_SEND=0
